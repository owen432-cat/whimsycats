/* ==========================================
   Whiskers & Witchcraft
   Theme by ChatGPT
========================================== */

@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:wght@400;600&family=Poppins:wght@300;400;500;600&display=swap');

:root{
    --bg:#F8F3E8;
    --card:#FFFDF8;
    --primary:#4C355E;
    --gold:#D8B25A;
    --sage:#7C9A74;
    --text:#4A3A32;
    --shadow:0 12px 25px rgba(0,0,0,.15);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.8;
}

h1,h2,h3,h4{
    font-family:'Cinzel',serif;
    color:var(--primary);
}

.quote{
    font-family:'Cormorant Garamond',serif;
    font-size:1.4rem;
    font-style:italic;
}

img{
    display:block;
    width:100%;
}

.container{
    width:min(1200px,90%);
    margin:auto;
}

section{
    padding:90px 0;
}

/* ===========================
Navigation
=========================== */

nav{
    position:fixed;
    top:0;
    width:100%;
    z-index:999;
    display:flex;
    justify-content:center;
    gap:35px;
    padding:18px;
    background:rgba(76,53,94,.95);
    backdrop-filter:blur(10px);
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:600;
    transition:.3s;
}

nav a:hover{
    color:var(--gold);
}

/* ===========================
Hero
=========================== */

.hero{
    height:100vh;

    background:
    linear-gradient(rgba(30,20,40,.55),
    rgba(30,20,40,.65)),
    url("images/hero.jpg") center/cover no-repeat;

    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:white;
}

.hero-content{
    max-width:850px;
    padding:20px;
}

.hero h1{
    color:white;
    font-size:4rem;
    margin-bottom:20px;
}

.hero p{
    color:white;
    margin-bottom:40px;
    font-size:1.3rem;
}

.button{
    display:inline-block;
    background:var(--gold);
    color:#222;
    text-decoration:none;
    padding:15px 35px;
    border-radius:50px;
    font-weight:bold;
    transition:.3s;
}

.button:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 25px rgba(0,0,0,.2);
}

/* ===========================
Titles
=========================== */

.section-title{
    text-align:center;
    margin-bottom:60px;
}

.section-title h2{
    font-size:2.8rem;
    margin-bottom:15px;
}

.section-title p{
    max-width:700px;
    margin:auto;
}

/* ===========================
Meet the Cats
=========================== */

.cat-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:35px;
}

.cat-card{
    background:var(--card);
    border-radius:20px;
    overflow:hidden;
    box-shadow:var(--shadow);
    transition:.35s;
}

.cat-card:hover{
    transform:translateY(-10px);
}

.cat-card img{
    height:350px;
    object-fit:cover;
}

.cat-info{
    padding:30px;
}

.cat-info h3{
    margin-bottom:15px;
}

.cat-info ul{
    margin-top:20px;
    padding-left:20px;
}

/* ===========================
Gallery
=========================== */

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.gallery-item{
    background:white;
    border-radius:18px;
    overflow:hidden;
    box-shadow:var(--shadow);
    transition:.3s;
}

.gallery-item:hover{
    transform:translateY(-8px);
}

.gallery-item img{
    height:280px;
    object-fit:cover;
    transition:.4s;
}

.gallery-item:hover img{
    transform:scale(1.05);
}

.gallery-caption{
    padding:20px;
}

.gallery-caption h4{
    margin-bottom:10px;
}

/* ===========================
History
=========================== */

.history{
    background:#EFE6D6;
}

.timeline{
    display:grid;
    gap:30px;
}

.timeline-item{
    background:white;
    border-left:6px solid var(--gold);
    padding:30px;
    border-radius:15px;
    box-shadow:var(--shadow);
}

/* ===========================
Love Section
=========================== */

.love-card{
    background:white;
    max-width:900px;
    margin:auto;
    padding:45px;
    border-radius:20px;
    box-shadow:var(--shadow);
}

.love-card p{
    margin-bottom:25px;
}

/* ===========================
Footer
=========================== */

footer{
    background:var(--primary);
    color:white;
    text-align:center;
    padding:50px 20px;
}

footer h3{
    color:white;
}

footer p{
    margin:12px 0;
}

/* ===========================
Fade Animation
=========================== */

.fade{
    opacity:0;
    transform:translateY(40px);
    transition:1s;
}

.fade.show{
    opacity:1;
    transform:translateY(0);
}

/* ===========================
Hover Glow
=========================== */

.cat-card:hover,
.gallery-item:hover,
.timeline-item:hover{
    box-shadow:
    0 20px 40px rgba(0,0,0,.18),
    0 0 15px rgba(216,178,90,.25);
}

/* ===========================
Responsive
=========================== */

@media(max-width:900px){

.hero h1{
    font-size:3rem;
}

.hero p{
    font-size:1.1rem;
}

nav{
    flex-wrap:wrap;
    gap:15px;
}

section{
    padding:70px 0;
}

}

@media(max-width:600px){

.hero h1{
    font-size:2.2rem;
}

.section-title h2{
    font-size:2rem;
}

.button{
    padding:12px 25px;
}

.love-card{
    padding:30px;
}

.cat-card img,
.gallery-item img{
    height:220px;
}

}